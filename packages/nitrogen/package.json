{
  "name": "@cloudcart/nitrogen-plugin",
  "version": "2.0.1",
  "description": "CloudCart Nitrogen storefront commands",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudcart/cli-kit": "workspace:*",
    "@oclif/core": "^4.2.8",
    "cross-spawn": "^7.0.6",
    "semver": "^7.7.4",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "oclif": {
    "commands": {
      "strategy": "pattern",
      "target": "./dist/commands"
    },
    "topics": {
      "nitrogen": {
        "description": "Nitrogen storefronts: create, link, develop, build and deploy to Nova"
      },
      "nitrogen:env": {
        "description": "The linked storefront's environment variables: list, pull into .env, push"
      },
      "nitrogen:generate": {
        "description": "Copy the CloudCart starter's routes into the project"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cloudcart/cli.git",
    "directory": "packages/nitrogen"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
