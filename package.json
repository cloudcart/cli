{
  "name": "cloudcart-cli",
  "private": true,
  "description": "CloudCart Developer CLI",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev",
    "test": "pnpm -r run test",
    "lint": "node scripts/check-names.mjs && pnpm -r run lint",
    "clean": "pnpm -r run clean",
    "typecheck": "pnpm -r run typecheck",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "simple-git-hooks": "^2.14.0"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/require-committed-tree.mjs && pnpm check"
  }
}
